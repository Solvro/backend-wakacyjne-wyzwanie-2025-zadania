// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
}

model Participant {
  id          Int     @id @default(autoincrement())
  first_name  String
  second_name String?
  last_name   String
  email       String   @unique
  gender      Gender
  trips       Trip[]
}

model Trip {
  id             Int         @id @default(autoincrement())
  destination    String
  participant_id Int
  expense        Expense[]
  date_start     DateTime
  user           Participant @relation(fields: [participant_id], references: [id])
}

model Expense {
  id            Int   @id @default(autoincrement())
  description   String
  trip_id       Int
  trip          Trip  @relation(fields: [trip_id], references: [id])
  price         Float
}
