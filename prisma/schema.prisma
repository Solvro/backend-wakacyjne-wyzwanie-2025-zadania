// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trip {
  id  Int @id @default(autoincrement())
  name  String
  start_date  DateTime
  end_date  DateTime
  participants  Participant[]
  expenses  Expense[]
}

model Participant {
  id  Int @id @default(autoincrement())
  name  String
  surname String
  email String? @unique
  phone String? @unique
  trip  Trip @relation(fields: [trip_id], references: [id])
  trip_id Int
}

model Expense {
  id Int @id @default(autoincrement())
  name String
  amount Decimal
  type Expense_Type
  trip  Trip @relation(fields: [trip_id], references: [id])
  trip_id Int
}

enum Expense_Type {
  food
  accomodation
  entrance_fee
  rental_fee
}
