// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Participants {
  id            Int         @id @default(autoincrement())
  tripId        Int
  trip        Trip        @relation(fields: [tripId], reference: [id])
  name          String
  age           Int
  role          Role
}

enum Role {
  GUIDE
  PARTICIPANT
  DRIVER
}

model Trip {
  id            Int         @id @default(autoincrement())
  destination   String
  date          DateTime
  transport     Transport
  attractions   String?
  duration      Int
}

enum Transport {
  BUS
  PLANE
  TRAIN
  BOAT
}

model Expense {
  id            Int         @id @default(autoincrement())
  tripId        Int
  trip        Trip        @relation(fields: [tripId], reference: [id])
  cost          Float
  additional    Float?
}