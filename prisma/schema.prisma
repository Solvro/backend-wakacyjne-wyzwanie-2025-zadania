generator client {
  provider = "prisma-client-js"
}



datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trip{
  id          Int @id @default(autoincrement())
  title        String
  description  String
  startDate    DateTime
  endDate      DateTime

  participants Participant[]
  expenses     Expense[]

}

model Expense {
  id          Int @id @default(autoincrement())
  amount      Float
  description String
  createdAt   DateTime @default(now())

  trip        Trip @relation(fields: [tripId], references: [id])
  tripId      Int
}

model User {
  email       String @unique @id
  name        String
  middleName  String? 
  lastName    String
  sex         Sex

  password    String
  isEnabled   Boolean @default(true)
  role        Role @default(USER)
  participants Participant[]


}

model Participant {
  id          Int @id @default(autoincrement())
  user        User @relation(fields: [userEmail], references: [email])
  userEmail     String
  trip        Trip @relation(fields: [tripId], references: [id])
  tripId      Int
 

}

enum Role {
  USER
  GUIDE
  ADMIN
}


enum Sex {
  MALE
  FEMALE
  OTHER
}