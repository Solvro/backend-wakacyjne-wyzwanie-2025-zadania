// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Trip {
  id           Int               @id @default(autoincrement())
  name         String?
  startDate    DateTime?
  endDate      DateTime?
  totalCost    Int?

  // relacje
  expanses     Expanse[]         // 1 Trip -> wiele Expanses
  participants TripParticipant[] // M:N z Participant

  @@map("Trip")
}

model Participant {
  id        Int              @id @default(autoincrement())
  name      String?
  surname   String?
  role      Int?

  trips     TripParticipant[] // M:N z Trip

  @@map("Participant")
}

model Expanse {
  id          Int      @id @default(autoincrement())
  tripId      Int
  amount      Int?
  category    String?
  description String?
  date        DateTime?

  trip        Trip     @relation(fields: [tripId], references: [id])

  @@map("Expanse")
}

model TripParticipant {
  id             Int          @id @default(autoincrement())
  tripId         Int
  participantId  Int

  trip           Trip         @relation(fields: [tripId], references: [id])
  participant    Participant  @relation(fields: [participantId], references: [id])

  @@map("TripParticipant")
}
