// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  TRIP_COORDINATOR
}

model User {
  email      String    @id
  password   String
  name       String?
  role       Role      @default(USER)
  birthday   DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  participants Participant[]
  expenses     Expense[]

  @@map("User")
}

model Trip {
  id          Int      @id @default(autoincrement())
  destination String
  description String?
  start       DateTime
  end         DateTime
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  expenses     Expense[]
  participants Participant[]

  @@map("Trip")
}

model Participant {
  id         Int      @id @default(autoincrement())
  trip_id    Int
  user_email String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  trip Trip @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_email], references: [email], onDelete: Cascade)

  @@map("Participant")
}

model Expense {
  id          Int      @id @default(autoincrement())
  what        String
  description String?
  amount      Decimal  @db.Decimal(10, 2)
  trip_id     Int
  user_email  String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  trip   Trip   @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [user_email], references: [email], onDelete: Cascade)

  @@map("Expense")
}