generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExpenseCategory {
  FOOD
  TRAVEL
  LODGING
  OTHER
}

enum ParticipantRole {
  ORGANIZER
  MEMBER
}

model Trip {
  id           Int           @id @default(autoincrement())
  name         String
  startDate    DateTime
  endDate      DateTime?
  budget       Float?
  createdAt    DateTime      @default(now())

  participants Participant[]
  expenses     Expense[]
}

model Participant {
  id        Int              @id @default(autoincrement())
  name      String
  lastname  String
  email     String?
  role      ParticipantRole  @default(MEMBER)
  createdAt DateTime         @default(now())

  trip   Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId Int

  expenses Expense[] @relation("ParticipantExpenses")
}

model Expense {
  id        Int             @id @default(autoincrement())
  amount    Float
  category  ExpenseCategory
  note      String?
  spentAt   DateTime        @default(now())
  createdAt DateTime        @default(now())

  trip   Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId Int

  participant   Participant @relation("ParticipantExpenses", fields: [participantId], references: [id], onDelete: SetNull)
  participantId Int
}
