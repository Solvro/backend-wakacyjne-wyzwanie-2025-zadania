generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trip {
  trip_id     Int       @id @default(autoincrement())
  name        String
  date_start  DateTime
  date_end    DateTime
  description String?
  expenses    Expense[]
  participants    TripParticipant[] 
}

model Expense {
  expense_id     Int         @id @default(autoincrement())
  title          String
  category       Category
  amount         Decimal
  currency       CurrencyName
  date           DateTime
  trip_id        Int
  trip           Trip        @relation(fields: [trip_id], references: [trip_id])
  participant_id Int
  participant    Participant @relation(fields: [participant_id], references: [participant_id])
  payments       Payments[]
  paid           Boolean
}

model Participant {
  participant_id Int       @id @default(autoincrement())
  name           String
  email          String    @unique
  password       String
  role           Role      @default(Participant)
  isEnabled      Boolean   @default(true)
  expenses       Expense[]
  trips          TripParticipant[]
}

model TripParticipant {
  id              Int           @id @default(autoincrement())
  trip            Trip          @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade)
  trip_id         Int
  participant     Participant   @relation(fields: [participant_id], references: [participant_id], onDelete: Cascade)
  participant_id  Int

  @@unique([trip_id, participant_id]) 
}

model Currency {
  currency_id Int @id @default(autoincrement())
  currency  CurrencyName
  value  Decimal
  timeStamp DateTime
}

model Payments {
  payment_id  Int @id @default(autoincrement())
  date  DateTime
  currency CurrencyName
  amount  Decimal @db.Decimal(18, 2)
  amountPLN Decimal @db.Decimal(18, 2)
  expense_id Int
  expense Expense @relation(fields: [expense_id], references: [expense_id], onDelete: Cascade)
}

enum Category {
  Transport
  Jedzenie
  Nocleg
  Rozrywka
}

enum Role {
  Participant
  Admin
  Trip_Coordinator
}

enum CurrencyName {
  PLN
  EUR
  USD
  GBP
}
