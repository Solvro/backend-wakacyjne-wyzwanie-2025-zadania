// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trip {
  id          Int       @id @default(autoincrement())
  name        String
  destination String?
  budget      Decimal?  @db.Decimal(12, 2)
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date
  createdAt   DateTime  @default(now())

  coordinatorEmail String
  coordinator      User?  @relation(fields: [coordinatorEmail], references: [email])

  participants Participant[]

  expenses Expense[]
}

model Participant {
  id        Int    @id @default(autoincrement())
  firstName String
  lastName  String
  email     String

  trips     Trip[]
  userEmail String?
  user      User?   @relation(fields: [userEmail], references: [email])

  role Role @default(PARTICIPANT)

  paidExpenses Expense[]
}

enum Type {
  FOOD
  TRANSPORT
  ACCOMODATION
  PARKING
  OTHER
}

model Expense {
  id          Int     @id @default(autoincrement())
  description String
  cost        Decimal @db.Decimal(12, 2)
  type        Type
  tripId      Int
  payerId     Int

  trip  Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  payer Participant @relation(fields: [payerId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([payerId])
}

model User {
  email        String        @id
  password     String
  role         AuthRole
  isEnabled    Boolean
  name         String?
  participants Participant[] // relacja 1:N z Participant
  Trip         Trip[]
}

enum Role {
  GUIDE
  PARTICIPANT
}

enum AuthRole {
  ADMIN
  USER
  COORDINATOR
}
