generator client {
  provider = "prisma-client-js"
  //output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Participant {
  id    Int     @default(autoincrement()) @id
  name String  
  surname  String
  age Int
  trip_id Int
  gender  Gender
  trip  Trip  @relation(fields: [trip_id], references: [id])
}

model Trip {
  id    Int     @default(autoincrement()) @id
  startDate   DateTime
  endDate DateTime
  location  String
  participant Participant[]  
  expense     Expense[] 
}

model Expense {
  id    Int     @default(autoincrement()) @id
  daily_price   Float
  trip_id  Int
  discount Boolean?
  trip  Trip  @relation(fields: [trip_id], references: [id])
}

enum Gender {
  M
  F
}
