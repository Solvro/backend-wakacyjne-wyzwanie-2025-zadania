// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  password          String
  name              String?
  role              UserRole  @default(USER)
  expenses          Expense[]
  coordinatedTrips  Trip[]    @relation("TripCoordinator")
}

model Trip {
  id            Int        @id @default(autoincrement())
  name          String
  description   String?
  destination   String
  travel_type   TravelType
  start_date    DateTime
  end_date      DateTime
  coordinator   User       @relation("TripCoordinator", fields: [coordinator_id], references: [id])
  coordinator_id Int
  expenses      Expense[]
}

model Expense {
  id      Int   @id @default(autoincrement())
  price   Float
  trip    Trip  @relation(fields: [trip_id], references: [id])
  trip_id Int
  user    User  @relation(fields: [user_id], references: [id])
  user_id Int
}

model Currency {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  rate      Float
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  payments  Payment[]
}

model Payment {
  id               Int      @id @default(autoincrement())
  originalAmount   Float
  originalCurrency Currency @relation(fields: [currencyId], references: [id])
  currencyId       Int
  amountInPLN      Float
  exchangeRate     Float
  createdAt        DateTime @default(now())
}

enum UserRole {
  USER
  ADMIN
}

enum TravelType {
  BUS
  PLANE
  TRAIN
  CAR
}
