generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}



datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trip{
  id          Int @id @default(autoincrement())
  title        String
  description  String
  startDate    DateTime
  endDate      DateTime

  participants Participant[]
  expenses     Expense[]

}

model Expense {
  id          Int @id @default(autoincrement())
  amount      Float
  description String
  createdAt   DateTime @default(now())

  trip        Trip @relation(fields: [tripId], references: [id])
  tripId      Int
}

model User {
  id          Int @id @default(autoincrement())
  name        String
  middleName  String?
  lastName    String
  sex         Sex
  email       String @unique

  participants Participant[]


}

model Participant {
  id          Int @id @default(autoincrement())
  user        User @relation(fields: [userId], references: [id])
  userId      Int
  trip        Trip @relation(fields: [tripId], references: [id])
  tripId      Int

}

enum Sex {
  MALE
  FEMALE
}